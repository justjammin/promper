{
  "name": "@ninjamin/promper",
  "version": "0.4.2",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "Prompt-engineering toolkit for Claude Code and Codex: discover evidence, validate plans, compile project graphs, run bounded goal-directed graph execution, and review results.",
  "bin": {
    "promper": "bin/promper.mjs"
  },
  "scripts": {
    "build": "tsc --noEmit && node tools/build-dist.mjs && npm run build:manifests",
    "build:manifests": "node tools/gen-manifests.mjs",
    "deps:skills": "npm ci --prefix skills/horizon --no-audit --no-fund && npm ci --prefix skills/sideeye --no-audit --no-fund",
    "test": "npm run deps:skills && node --test"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "skills/",
    "!skills/**/node_modules/**",
    "reference/",
    "hooks/",
    "tools/",
    "plugin.source.json",
    ".claude-plugin/",
    ".codex-plugin/",
    "README.md",
    "assets/"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.1.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "prompt-engineering",
    "agents",
    "prompt",
    "orchestration",
    "claude-code"
  ],
  "author": {
    "name": "Jamin Echols",
    "url": "https://github.com/justjammin"
  },
  "homepage": "https://github.com/justjammin/promper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justjammin/promper.git"
  },
  "license": "Apache-2.0"
}
