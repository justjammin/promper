{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "promper-orbit/viz/status.schema.json",
  "title": "Orbit Run Status (tracker feed)",
  "description": "Live run state the retro satellite tracker renders. Deliberately carries STATE only — deciding / decided / consensus-reached — never the decision content (no votes, no rationale, no plan text). The visualization shows that a decision is happening or made, not what it is.",
  "type": "object",
  "required": ["run", "phases", "magi"],
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "object",
      "required": ["slug", "engine", "tribunal"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string" },
        "engine": { "enum": ["breakdown", "singularity"] },
        "tribunal": { "enum": ["solo", "magi"] },
        "startedAt": { "type": "string" }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["genesis", "sideeye", "horizon", "execute", "review"] },
          "label": { "type": "string" },
          "status": {
            "enum": ["pending", "active", "done", "blocked"],
            "description": "pending=dim, active=amber, done=green, blocked=red"
          }
        }
      }
    },
    "magi": {
      "type": "object",
      "required": ["active", "state", "cores"],
      "additionalProperties": false,
      "properties": {
        "active": { "type": "boolean", "description": "false until the tribunal is initialized; the MAGI panel only appears when true" },
        "state": {
          "enum": ["idle", "deciding", "decided"],
          "description": "tribunal-level lamp: idle | deciding (amber pulse) | decided (locked)"
        },
        "consensusReached": { "type": "boolean", "description": "state flag only — NOT the verdict text" },
        "cores": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["name", "state"],
            "additionalProperties": false,
            "properties": {
              "name": { "enum": ["MELCHIOR-1", "BALTHASAR-2", "CASPER-3"] },
              "state": {
                "enum": ["deciding", "decided"],
                "description": "per-core lamp. deciding=amber pulse, decided=green. The vote (APPROVE/DENY) and rationale are intentionally absent from this feed."
              }
            }
          }
        }
      }
    }
  }
}
